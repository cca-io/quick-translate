{
  "name": "quick-translate",
  "sources": [
    {
      "dir": "src",
      "subdirs": true
    },
    {
      "dir": "features/step_definitions",
      "subdirs": true,
      "type": "dev"
    }
  ],
  "package-specs": [
    {
      "module": "esmodule",
      "in-source": true
    }
  ],
  "suffix": ".mjs",
  "dependencies": [
    "@rescript/react"
  ],
  "warnings": {
    "error": "+101"
  },
  "jsx": {
    "version": 4,
    "mode": "automatic"
  },
  "reanalyze": {
    "suppress": [
      "src/bindings"
    ]
  }
}
